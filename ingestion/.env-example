# MongoDB Configuration
MONGODB_URI=your_mongodb_uri_here
MONGODB_DATABASE=blogdb
MONGODB_COLLECTION=ai_news

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-news-index

# VoyageAI Configuration
VOYAGEAI_API_KEY=your_voyageai_api_key_here
EMBEDDING_MODEL=voyage-large-2-instruct
DIMENSIONS=1024

# Search Configuration
INITIAL_SLEEP_TIME=5  # Initial delay between retries in seconds
MAX_SLEEP_TIME=60  # Maximum delay between retries in seconds
MAX_RESULTS=50  # Maximum number of results to fetch per query
TIME_LIMIT=d  # Time limit for search results (d = day, w = week, m = month)
MAX_RETRIES=5  # Maximum number of retry attempts for failed requests
TIMEOUT=30  # Request timeout in seconds

# DuckDuckGo Search Configuration
DDGS_TIMEOUT=30  # Timeout for DuckDuckGo search requests in seconds